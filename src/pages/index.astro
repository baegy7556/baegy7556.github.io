---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, site, highlights, skills, experience, education } from '../lib/data';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const hasLinks = profile.cv || profile.github || profile.linkedin || profile.email;
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      {profile.headline && <p class="label">{profile.headline}</p>}
      <h1 id="hero-title">{profile.name}</h1>
      {profile.tagline && <p class="tagline">{profile.tagline}</p>}
      {
        profile.facts.length > 0 && (
          <ul class="facts">
            {profile.facts.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        )
      }
      {
        hasLinks && (
          <div class="actions">
            {profile.cv && (
              <a class="btn btn-primary" href={profile.cv} download>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14" />
                </svg>
                {site.buttons.downloadCv}
              </a>
            )}
            {profile.github && <a class="btn" href={profile.github}>{site.buttons.github}</a>}
            {profile.linkedin && <a class="btn" href={profile.linkedin}>{site.buttons.linkedin}</a>}
            {profile.email && <a class="btn" href={`mailto:${profile.email}`}>{site.buttons.email}</a>}
          </div>
        )
      }
    </div>
  </section>

  {
    highlights.length > 0 && (
      <section class="section" aria-labelledby="highlights-title">
        <div class="container">
          <h2 id="highlights-title">{site.sections.highlights}</h2>
          <ul class="highlights">
            {highlights.map((h) => (
              <li>
                <h3>{h.title}</h3>
                {h.body && <p>{h.body}</p>}
                {h.proof && <p class="label">→ {h.proof}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section id="projects" class="section" aria-labelledby="projects-title">
        <div class="container">
          <h2 id="projects-title">{site.sections.projects}</h2>
          <div class="grid">
            {projects.map((p, i) => (
              <ProjectCard project={p} eager={i < 2} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    skills.length > 0 && (
      <section id="skills" class="section" aria-labelledby="skills-title">
        <div class="container">
          <h2 id="skills-title">{site.sections.skills}</h2>
          <dl class="skills">
            {skills.map((s) => (
              <div>
                <dt class="label">{s.name}</dt>
                <dd>{s.items.join(' · ')}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {
    experience.length + education.length > 0 && (
      <section id="experience" class="section">
        <div class="container two-col">
          {experience.length > 0 && (
            <div>
              <h2>{site.sections.experience}</h2>
              <ol class="timeline">
                {experience.map((e) => (
                  <li>
                    <h3>{e.role}</h3>
                    <p class="meta">
                      {[e.org, e.location].filter(Boolean).join(' · ')}
                      {e.period && <span class="label"> · {e.period}</span>}
                    </p>
                    {e.points.length > 0 && (
                      <ul>
                        {e.points.map((pt) => (
                          <li>{pt}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          )}
          {education.length > 0 && (
            <div>
              <h2>{site.sections.education}</h2>
              <ol class="timeline">
                {education.map((e) => (
                  <li>
                    <h3>{e.degree}</h3>
                    <p class="meta">
                      {e.school}
                      {e.period && <span class="label"> · {e.period}</span>}
                    </p>
                    {e.points.length > 0 && (
                      <ul>
                        {e.points.map((pt) => (
                          <li>{pt}</li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  h1 {
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    letter-spacing: -0.02em;
    margin: 0.25rem 0 0.75rem;
  }
  .tagline {
    font-size: 1.2rem;
    max-width: 40rem;
    margin: 0 0 1rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .facts li::before {
    content: '▸ ';
    color: var(--accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .highlights {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .highlights li {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  .highlights h3 {
    font-size: 1.05rem;
  }
  .highlights p {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }
  .highlights .label {
    margin: 0;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }

  .skills {
    display: grid;
    gap: 0.9rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    margin: 0;
  }
  .skills dd {
    margin: 0.15rem 0 0;
  }

  .two-col {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 56rem) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline > li {
    padding: 0 0 1.25rem 1rem;
    border-left: 2px solid var(--border);
  }
  .timeline h3 {
    font-size: 1.02rem;
    margin: 0;
  }
  .meta {
    margin: 0.15rem 0 0.4rem;
    color: var(--muted);
    font-size: 0.93rem;
  }
  .timeline ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.95rem;
  }
</style>
