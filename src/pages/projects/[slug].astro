---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/data';
import { getProjects } from '../../lib/projects';
import { resolveMedia } from '../../lib/media';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, cover, coverAlt, tags, role, period, status, links } = project.data;
const media = resolveMedia(project.data.media);
const { Content } = await render(project);
const hasSpec = role || period || status || tags.length > 0;
// Link previews (KakaoTalk, LinkedIn, Slack…) can't show SVG, so only a raster cover is used;
// otherwise Base falls back to the site-wide share image.
const shareImage = cover && /\.(png|jpe?g|webp)$/i.test(cover) ? cover : undefined;
---

<Base title={title} description={summary} image={shareImage} imageAlt={shareImage ? coverAlt : undefined} type="article">
  <article class="container project">
    <p><a href="/#projects">{site.project.back}</a></p>
    <header>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </header>

    {
      hasSpec && (
        <dl class="spec">
          {role && (
            <div>
              <dt class="label">{site.project.role}</dt>
              <dd>{role}</dd>
            </div>
          )}
          {period && (
            <div>
              <dt class="label">{site.project.period}</dt>
              <dd>{period}</dd>
            </div>
          )}
          {status && (
            <div>
              <dt class="label">{site.project.status}</dt>
              <dd>{status}</dd>
            </div>
          )}
          {tags.length > 0 && (
            <div class="wide">
              <dt class="label">{site.project.tech}</dt>
              <dd>
                <ul class="tags">
                  {tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      )
    }

    {
      links.length > 0 && (
        <nav class="links" aria-label={site.project.links}>
          {links.map((l) => (
            <a class="btn" href={l.url}>
              {l.label}
            </a>
          ))}
        </nav>
      )
    }

    {cover && <img class="cover" src={cover} alt={coverAlt ?? ''} width="1200" height="675" decoding="async" />}

    <div class="prose">
      <Content />
    </div>

    {
      media.length > 0 && (
        <section aria-labelledby="media-title">
          <h2 id="media-title">{site.project.media}</h2>
          <div class="media">
            {media.map((m) => (
              <figure>
                {m.kind === 'image' && (
                  <img src={m.src} alt={m.alt ?? ''} width="1200" height="675" loading="lazy" decoding="async" />
                )}
                {m.kind === 'video' && (
                  <video src={m.src} controls preload="metadata" playsinline aria-label={m.alt ?? m.caption ?? title} />
                )}
                {m.kind === 'youtube' && (
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${m.id}`}
                    title={m.alt ?? m.caption ?? title}
                    loading="lazy"
                    allow="encrypted-media; picture-in-picture"
                    allowfullscreen
                  />
                )}
                {m.caption && <figcaption class="muted">{m.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .project {
    max-width: 48rem;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin: 0.5rem 0;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .spec {
    display: grid;
    gap: 0.75rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 0 0 1.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  .spec .wide {
    grid-column: 1 / -1;
  }
  .spec dd {
    margin: 0.2rem 0 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 1.5rem 0;
  }
  .prose :global(h2) {
    margin-top: 2rem;
    font-size: 1.35rem;
  }
  .prose :global(li) {
    margin: 0.25rem 0;
  }
  .prose :global(strong) {
    font-weight: 650;
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 1rem 0;
  }
  section {
    margin-top: 2rem;
  }
  .media {
    display: grid;
    gap: 1.25rem;
  }
  figure {
    margin: 0;
  }
  .media img,
  .media video,
  .media iframe {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }
  figcaption {
    font-size: 0.9rem;
    margin-top: 0.4rem;
  }
</style>
